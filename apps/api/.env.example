# Copiar a apps/api/.env (ignorado por git). Nunca subir secretos reales al repo.

NODE_ENV="development"
PORT="3000"

# Local (docker compose):  postgresql://xrlab:xrlab_dev@127.0.0.1:5433/xrlab
# Neon (usar el host con "-pooler"): postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/xrlab?sslmode=require
DATABASE_URL="postgresql://xrlab:xrlab_dev@127.0.0.1:5433/xrlab"
PG_POOL_MAX="5"

# Orígenes permitidos por CORS, separados por coma. En producción, solo el dominio del frontend.
CORS_ORIGINS="http://127.0.0.1:4300,http://localhost:4300"

# Rate limit global por IP.
THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="100"

# --- Se usarán en fases siguientes (todavía no se leen) ---
# QR_SIGNING_KEY=""            # Fase 3: firma de tokens QR (mínimo 32 caracteres)
# QR_TOKEN_TTL_SECONDS="15"
# QR_BATCH_SECONDS="60"
# QR_ROTATE_SECONDS="10"
# APP_TIMEZONE="America/Guayaquil"
# JWT_ACCESS_SECRET=""         # Fase 2
# JWT_REFRESH_SECRET=""        # Fase 2
# RESEND_API_KEY=""            # Fase 2: correo de invitación / reset
