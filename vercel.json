{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix apps/web ci",
  "buildCommand": "npm --prefix apps/web run build",
  "outputDirectory": "apps/web/dist/web/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://us-central1-xrlab-dev.cloudfunctions.net/xrlabApi/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(index\\.html|ngsw\\.json|ngsw-worker\\.js|manifest\\.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
